<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    android:background="#FFFFFF">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clHeader"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="#2C2D35"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/circle_button_background"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_backarrow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="Добавить комнату"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Поле ввода названия -->
    <EditText
        android:id="@+id/et_room_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Название комнаты"
        android:background="@drawable/bg_edit_text"
        android:layout_marginHorizontal="20dp"
        android:padding="12dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/clHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Заголовок "Выбрать комнату" -->
    <TextView
        android:id="@+id/tv_select_room"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Выбрать комнату"
        android:layout_marginHorizontal="20dp"
        android:textStyle="bold"
        android:textColor="#94949B"
        android:textSize="20sp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/et_room_name"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ========== РЯД 1 ========== -->

    <!-- Гостиная -->
    <LinearLayout
        android:id="@+id/layout_living_room"
        style="@style/RoomContainer"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_select_room"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/layout_kitchen"
        app:layout_constraintHorizontal_chainStyle="spread">

        <ImageView
            style="@style/RoomIcon"
            android:src="@drawable/ic_livingroom"
            android:contentDescription="Гостиная"/>

        <TextView
            style="@style/RoomText"
            android:text="Гостиная"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Кухня -->
    <LinearLayout
        android:id="@+id/layout_kitchen"
        style="@style/RoomContainer"
        app:layout_constraintTop_toTopOf="@id/layout_living_room"
        app:layout_constraintStart_toEndOf="@id/layout_living_room"
        app:layout_constraintEnd_toStartOf="@id/layout_bathroom">

        <ImageView
            style="@style/RoomIcon"
            android:src="@drawable/ic_kitchen"/>

        <TextView
            style="@style/RoomText"
            android:text="Кухня"/>
    </LinearLayout>

    <!-- Ванная -->
    <LinearLayout
        android:id="@+id/layout_bathroom"
        style="@style/RoomContainer"
        app:layout_constraintTop_toTopOf="@id/layout_living_room"
        app:layout_constraintStart_toEndOf="@id/layout_kitchen"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            style="@style/RoomIcon"
            android:src="@drawable/ic_bathroom"
            android:contentDescription="Ванная"/>

        <TextView
            style="@style/RoomText"
            android:text="Ванная"/>
    </LinearLayout>

    <!-- ========== РЯД 2 ========== -->

    <!-- Кабинет -->
    <LinearLayout
        android:id="@+id/layout_office"
        style="@style/RoomContainer"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/layout_living_room"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/layout_bedroom"
        app:layout_constraintHorizontal_chainStyle="spread">

        <ImageView
            style="@style/RoomIcon"
            android:src="@drawable/ic_office"
            android:contentDescription="Кабинет"/>

        <TextView
            style="@style/RoomText"
            android:text="Кабинет"/>
    </LinearLayout>

    <!-- Спальня -->
    <LinearLayout
        android:id="@+id/layout_bedroom"
        style="@style/RoomContainer"
        app:layout_constraintTop_toTopOf="@id/layout_office"
        app:layout_constraintStart_toEndOf="@id/layout_office"
        app:layout_constraintEnd_toStartOf="@id/layout_hall">

        <ImageView
            style="@style/RoomIcon"
            android:src="@drawable/ic_bedroom"
            android:contentDescription="Спальня"/>

        <TextView
            style="@style/RoomText"
            android:text="Спальня"/>
    </LinearLayout>

    <!-- Зал -->
    <LinearLayout
        android:id="@+id/layout_hall"
        style="@style/RoomContainer"
        app:layout_constraintTop_toTopOf="@id/layout_office"
        app:layout_constraintStart_toEndOf="@id/layout_bedroom"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            style="@style/RoomIcon"
            android:src="@drawable/ic_hall"
            android:contentDescription="Зал"/>

        <TextView
            style="@style/RoomText"
            android:text="Зал"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnSave"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:layout_marginHorizontal="70dp"
        android:layout_marginBottom="32dp"
        android:backgroundTint="#0B50A0"
        android:text="Сохранить"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>