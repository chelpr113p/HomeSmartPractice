<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clHeader"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#2C2D35"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/circle_button_background"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_backarrow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Телевизор"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clAcCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:background="@drawable/bg_device_card"
        android:padding="24dp"
        app:layout_constraintTop_toBottomOf="@id/clHeader">

        <ImageView
            android:id="@+id/ivAcIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_tv_blue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvAcName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Телевизор"
            android:textColor="#000000"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/ivAcIcon"
            app:layout_constraintEnd_toStartOf="@id/switchAc"
            app:layout_constraintStart_toEndOf="@id/ivAcIcon"
            app:layout_constraintTop_toTopOf="@id/ivAcIcon" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchAc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="#0B50A0"
            app:trackTint="#B0BEC5"
            app:layout_constraintBottom_toBottomOf="@id/ivAcIcon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/ivAcIcon" />


        <TextView
            android:id="@+id/tvTempTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Громкость:"
            android:textColor="#94949B"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivAcIcon" />

        <TextView
            android:id="@+id/tvVolumeValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="70%"
            android:textColor="#0B50A0"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tvTempTitle"
            app:layout_constraintStart_toEndOf="@id/tvTempTitle"
            app:layout_constraintTop_toTopOf="@id/tvTempTitle" />

        <SeekBar
            android:id="@+id/sbTemperature"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:max="100"
            android:progress="27"
            android:progressTint="#0B50A0"
            android:thumbTint="#0B50A0"
            app:layout_constraintTop_toBottomOf="@id/tvTempTitle" />

        <LinearLayout
            android:id="@+id/llTempLabels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/sbTemperature">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="0" android:textColor="#94949B" android:textSize="12sp" android:gravity="center" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="10" android:textColor="#94949B" android:textSize="12sp" android:gravity="center" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="20" android:textColor="#94949B" android:textSize="12sp" android:gravity="center" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="30" android:textColor="#94949B" android:textSize="12sp" android:gravity="center" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="40" android:textColor="#94949B" android:textSize="12sp" android:gravity="center" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="50" android:textColor="#94949B" android:textSize="12sp" android:gravity="center" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="60" android:textColor="#94949B" android:textSize="12sp" android:gravity="center" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="70" android:textColor="#94949B" android:textSize="12sp" android:gravity="center" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="80" android:textColor="#94949B" android:textSize="12sp" android:gravity="center" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="90" android:textColor="#94949B" android:textSize="12sp" android:gravity="center" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="100" android:textColor="#94949B" android:textSize="12sp" android:gravity="center" />
        </LinearLayout>



        <TextView
            android:id="@+id/tvTempTitle1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Яркость:"
            android:textColor="#94949B"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/llTempLabels" />

        <TextView
            android:id="@+id/tvBrightnessValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="70%"
            android:textColor="#0B50A0"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tvTempTitle1"
            app:layout_constraintStart_toEndOf="@id/tvTempTitle1"
            app:layout_constraintTop_toTopOf="@id/tvTempTitle1" />

        <SeekBar
            android:id="@+id/sbTemperature1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:max="100"
            android:progress="27"
            android:progressTint="#0B50A0"
            android:thumbTint="#0B50A0"
            app:layout_constraintTop_toBottomOf="@id/tvTempTitle1" />

        <LinearLayout
            android:id="@+id/llTempLabels1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/sbTemperature1">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="0" android:textColor="#94949B" android:textSize="12sp" android:gravity="center" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="10" android:textColor="#94949B" android:textSize="12sp" android:gravity="center" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="20" android:textColor="#94949B" android:textSize="12sp" android:gravity="center" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="30" android:textColor="#94949B" android:textSize="12sp" android:gravity="center" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="40" android:textColor="#94949B" android:textSize="12sp" android:gravity="center" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="50" android:textColor="#94949B" android:textSize="12sp" android:gravity="center" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="60" android:textColor="#94949B" android:textSize="12sp" android:gravity="center" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="70" android:textColor="#94949B" android:textSize="12sp" android:gravity="center" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="80" android:textColor="#94949B" android:textSize="12sp" android:gravity="center" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="90" android:textColor="#94949B" android:textSize="12sp" android:gravity="center" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="100" android:textColor="#94949B" android:textSize="12sp" android:gravity="center" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTempTitle2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:text="Ночной режим:"
            android:textColor="#94949B"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/llTempLabels1" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchNightmode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="#0B50A0"
            app:trackTint="#B0BEC5"
            app:layout_constraintBottom_toBottomOf="@id/tvTempTitle2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvTempTitle2" />

        <TextView
            android:id="@+id/tvPowerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Канал:"
            android:textColor="#94949B"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTempTitle2" />

        <LinearLayout
            android:id="@+id/llTempControl"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/tvPowerTitle" >

            <Button
                android:id="@+id/btnTempMinus"
                android:layout_width="66dp"
                android:layout_height="match_parent"
                android:text="-"
                android:textSize="25sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0B50A0" />

            <EditText
                android:id="@+id/tvChannelValue"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="3"
                android:background="@android:color/transparent"
                android:imeOptions="actionDone"
                tools:text="1"
                android:textColor="#0B50A0"
                android:textSize="24sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTempPlus"
                android:layout_width="66dp"
                android:layout_height="match_parent"
                android:text="+"
                android:textSize="25sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0B50A0" />
        </LinearLayout>


        <androidx.constraintlayout.widget.Group
            android:id="@+id/groupTvControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="tvTempTitle,tvVolumeValue,sbTemperature,llTempLabels,tvTempTitle1,tvBrightnessValue,sbTemperature1,llTempLabels1,tvTempTitle2,switchNightmode,tvPowerTitle,llTempControl"/>


    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>