<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clHeader"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#2C2D35"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/circle_button_background"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_backarrow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Тёплый пол"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clAcCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:background="@drawable/bg_device_card"
        android:padding="24dp"
        app:layout_constraintTop_toBottomOf="@id/clHeader">

        <ImageView
            android:id="@+id/ivAcIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_term_blue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvAcName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Теплый пол"
            android:textColor="#000000"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/ivAcIcon"
            app:layout_constraintEnd_toStartOf="@id/switchAc"
            app:layout_constraintStart_toEndOf="@id/ivAcIcon"
            app:layout_constraintTop_toTopOf="@id/ivAcIcon" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchAc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="#0B50A0"
            app:trackTint="#B0BEC5"
            app:layout_constraintBottom_toBottomOf="@id/ivAcIcon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/ivAcIcon" />

        <TextView
            android:id="@+id/tvTempTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Температура:"
            android:textColor="#94949B"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivAcIcon" />

        <TextView
            android:id="@+id/tvTempValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="27°C"
            android:textColor="#0B50A0"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tvTempTitle"
            app:layout_constraintStart_toEndOf="@id/tvTempTitle"
            app:layout_constraintTop_toTopOf="@id/tvTempTitle" />

        <SeekBar
            android:id="@+id/sbTemperature"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:max="35"
            android:progress="27"
            android:progressTint="#0B50A0"
            android:thumbTint="#0B50A0"
            app:layout_constraintTop_toBottomOf="@id/tvTempTitle" />

        <LinearLayout
            android:id="@+id/llTempLabels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingHorizontal="12dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/sbTemperature">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="0" android:textColor="#94949B" android:textSize="12sp" android:gravity="start" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="5" android:textColor="#94949B" android:textSize="12sp" android:gravity="center" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="10" android:textColor="#94949B" android:textSize="12sp" android:gravity="center" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="15" android:textColor="#94949B" android:textSize="12sp" android:gravity="center" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="20" android:textColor="#94949B" android:textSize="12sp" android:gravity="center" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="25" android:textColor="#94949B" android:textSize="12sp" android:gravity="center" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="30" android:textColor="#94949B" android:textSize="12sp" android:gravity="center" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="35" android:textColor="#94949B" android:textSize="12sp" android:gravity="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPowerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Мощность:"
            android:textColor="#94949B"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/llTempLabels" />

        <TextView
            android:id="@+id/tvPowerValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="70%"
            android:textColor="#0B50A0"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tvPowerTitle"
            app:layout_constraintStart_toEndOf="@id/tvPowerTitle"
            app:layout_constraintTop_toTopOf="@id/tvPowerTitle" />

        <SeekBar
            android:id="@+id/sbPower"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:max="100"
            android:progress="70"
            android:progressTint="#0B50A0"
            android:thumbTint="#0B50A0"
            app:layout_constraintTop_toBottomOf="@id/tvPowerTitle" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>